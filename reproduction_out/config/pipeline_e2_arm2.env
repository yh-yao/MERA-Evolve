# E2 arm 1 (LR=1e-5), research_plan.md E2 settings, 2 actor + 1 rollout on this 4-GPU node.
# Consumed by experiments/tau-2/10_4b_rl_pipeline.sh (repository pipeline, SMOKE=0).
RUN_DIR=/data/htlcrosssale-gps-share/powerop_transfer/mera_evolve_repro/results/e2_arm2_lr3e-5
STUDENT_MODEL=/data/htlcrosssale-gps-share/powerop_transfer/models/Qwen3.5-4B
USER_MODEL=/data/htlcrosssale-gps-share/powerop_transfer/models/Qwen3.5-4B
VLLM_BIN=/home/powerop/.conda/envs/fave-vllm-py311/bin/vllm
TAU2_WORKSPACE=/tmp/mera_envs/router-skills-evolve
MERA_AREAL_DIR=/data/htlcrosssale-gps-share/powerop_transfer/mera_evolve_repro/data/areal_tau2
TRAIN_VENV=/home/powerop/work/zsc/newproj/.venv
SERVE_GPU=0
TRAIN_GPUS=1,2
ROLLOUT_GPUS=3
EVAL_GPUS=0,1,2,3
PORT_BASE=8900
USE_AREAL=1
DATA_MIX=areal+train
TOOL_FORMAT=qwen3_coder
TOTAL_STEPS=200
SAVE_EVERY=25
TRAIN_BATCH_SIZE=16
N_GENERATIONS=8
MAX_PROMPT_LENGTH=8192
MAX_RESPONSE_LENGTH=16384
MAX_TURNS=30
ACTOR_LR=3e-5
PPO_MICRO_BATCH_SIZE=1
QWEN35_CUDA_HOME=/usr/local/cuda
QWEN35_TRAIN_TRITON_OVERLAY=/home/powerop/work/yjh/MERA-Evolve/.deps/qwen35-triton33
PYTHONPATH=/home/powerop/work/yjh/MERA-Evolve/experiments/tau-2/compat/qwen35_torch_fallback
QWEN35_ENABLE_VERL_PATCHES=1
