# Source this file or override variables inline before scripts/train_grpo.sh.

MODEL_PATH=Qwen/Qwen2.5-Coder-1.5B-Instruct
TRAIN_FILE=data/processed/train.parquet
VAL_FILE=data/processed/val.parquet

PROJECT_NAME=verl_code_rl
EXPERIMENT_NAME=qwen25_1p5b_he_mbpp_grpo

N_GPUS=1
ROLLOUT_TP=1
TRAIN_BATCH_SIZE=64
VAL_BATCH_SIZE=128
PPO_MINI_BATCH_SIZE=16
# batch=1 left an 80GB H100 at ~13GB used during update_actor (measured on a
# 1.5B model + LoRA) -- these were tuned for a much smaller/shared GPU.
PPO_MICRO_BATCH_SIZE_PER_GPU=8
LOG_PROB_MICRO_BATCH_SIZE_PER_GPU=16
N_GENERATIONS=8

MAX_PROMPT_LENGTH=1536
MAX_RESPONSE_LENGTH=768
TEMPERATURE=0.8
TOP_P=0.95
LR=1e-6
TOTAL_EPOCHS=1
SAVE_FREQ=20
TEST_FREQ=10
GPU_MEMORY_UTILIZATION=0.5

# LoRA training (default; matches router-skills-evolve's frozen-base + r=16
# adapter algorithm). Set LORA_RANK=0 for full-parameter fine-tuning.
LORA_RANK=16
LORA_ALPHA=32
LORA_TARGET_MODULES=[q_proj,k_proj,v_proj,o_proj]
