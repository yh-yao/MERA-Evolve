# Config for experiments/tau-2/10_4b_rl_pipeline.sh (research_plan.md E0-E2).
# Copy, edit the paths and GPUs, then:
#   bash experiments/tau-2/10_4b_rl_pipeline.sh my.env                 # all stages
#   SMOKE=1 bash experiments/tau-2/10_4b_rl_pipeline.sh my_smoke.env   # plumbing check (~1 h)
# Every value below has a default in the script except the ones marked REQUIRED.

# ---- paths (REQUIRED) ----
RUN_DIR=/abs/path/MERA-Evolve/results/e2_4b_grpo_run1      # all outputs; resume by re-running with the same RUN_DIR
STUDENT_MODEL=/abs/path/models/Qwen3.5-4B
USER_MODEL=/abs/path/models/Qwen3.5-4B                     # user simulator; keep 4B so numbers match research_plan.md
VLLM_BIN=/abs/path/.venv_vllm/bin/vllm                     # serving env (vLLM >= 0.29 for Qwen3.5)
TAU2_WORKSPACE=/abs/path/router-skills-evolve              # holds .venv_tau2 and the tau2-bench checkout
# TRAIN_VENV=/abs/path/MERA-Evolve/.venv_qwen35            # default: <repo>/.venv_qwen35
MERA_AREAL_DIR=/abs/path/data/areal_tau2                   # AReaL-tau2-data: tau2_rl_train.jsonl + dbs/ (+ valid_task_ids.json, built by `check`)

# ---- GPUs (REQUIRED) ----
# SERVE_GPU: user simulator during GRPO (vLLM, ~40% of an 80 GB card or a whole 32 GB card).
# TRAIN_GPUS / ROLLOUT_GPUS: FSDP actor and VERL rollout workers (comma lists for one node).
# EVAL_GPUS: evaluation / R1 collection; each runs student + user simulator together.
SERVE_GPU=0
TRAIN_GPUS=1,2,3
ROLLOUT_GPUS=4,5
EVAL_GPUS=6,7
PORT_BASE=8500                                             # uses PORT_BASE .. PORT_BASE+91

# ---- data ----
USE_AREAL=1               # 0: only the 97 tau2 TRAIN tasks (then DATA_MIX must be train)
DATA_MIX=areal+train      # areal+train | train
R1_TRIALS=4               # samples per task used to find 0 < p < 1 tasks

# ---- GRPO (research_plan.md E2) ----
ACTOR_LR=1e-5             # E2 runs 1e-5 and 3e-5 as two RUN_DIRs
TOTAL_STEPS=200
TRAIN_BATCH_SIZE=16       # prompts per step
N_GENERATIONS=8           # samples per prompt
SAVE_EVERY=25
MAX_RESPONSE_LENGTH=16384 # multi-turn trajectory budget; keep truncation < 5% (script warns)
MAX_PROMPT_LENGTH=8192
MAX_TURNS=30
ENABLE_TIS=1              # token-level truncated importance sampling for the one-step off-policy rollout
TIS_THRESHOLD=2.0
ACTOR_MODEL_DTYPE=bf16    # starting point; validate and freeze in research_plan.md Section I
CHECKPOINT_BUCKET_MB=2560 # must exceed the 4B embedding (~1.27 GB bf16)
# LORA_RANK=16 LORA_ALPHA=32
# EXTRA_TRAIN_ARGS="..."  # extra VERL Hydra overrides, appended; a key set here replaces the pipeline's own value

# ---- training infrastructure (research_plan.md Section I) ----
# Every variable in this file is exported, so these reach 09 / 03_grpo_only.sh / train_verl_grpo.sh.
# Unset = the lower layer's default. The values actually used are written to $RUN_DIR/train_settings.env.
# PPO_MICRO_BATCH_SIZE=1              # per-GPU micro batch; the global batch stays TRAIN_BATCH_SIZE x N_GENERATIONS
# AGENT_LOOP_WORKERS=16               # TRAIN_BATCH_SIZE x N_GENERATIONS must be a multiple of this
# REWARD_WORKERS=2
# RAY_NUM_CPUS=24
# ROLLOUT_GPU_MEMORY_UTILIZATION=0.70
# ROLLOUT_ENFORCE_EAGER=True          # graph mode only after an isolated compatibility check
# USE_REMOVE_PADDING=True
# USE_FUSED_KERNELS=True
# ACTOR_PARAM_OFFLOAD=False           # keep offload off unless memory is the measured constraint
# ACTOR_OPTIMIZER_OFFLOAD=False
# MERA_WEIGHT_TRANSFER_SHM=1          # 09 default: weight sync through shared memory (required without GPU P2P); try 0 only after a check

# ---- evaluation ----
PASS_DELTA=0.05           # frontier gate: delta >= 5 pt and bootstrap CI low > 0
VAL_SEEDS="300 1300"      # VAL seeds for checkpoints that pass the gate
# VAL_CKPTS="100 200"     # force VAL for these steps instead of the gated ones
# The 58 frontier tasks overlap the TRAIN-derived GRPO prompts (27 of 36 in our run), so the frontier
# gate measures "learned the training tasks", not transfer. To gate on unseen tasks, point this at a
# partition whose TRAIN bucket excludes the selected prompts; VAL stays the deciding metric either way.
# FRONTIER_PARTITION=/abs/path/partition_frontier_heldout.json
